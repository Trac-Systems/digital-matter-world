[Unit]
Description=Digital Matter World operator %i threshold sidecar
After=network-online.target

[Service]
User=dmw-%i
Group=dmw-%i
WorkingDirectory=/opt/dmw/current
ExecStart=/opt/dmw/bin/dmw-tss /var/lib/dmw/%i/sidecar.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dmw/%i
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target
