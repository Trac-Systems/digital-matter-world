{
  "name": "@digital-matter-world/kit",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "bin": {
    "dmw": "bin/dmw.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.mjs",
    "test:devnet": "node --test --test-timeout=120000 test/devnet.e2e.mjs",
    "test:bitcoin": "node --test --test-timeout=60000 test/bitcoin.e2e.mjs",
    "test:history": "node --test test/history.e2e.mjs",
    "build:player-wallet": "node scripts/build-player-wallet.mjs",
    "test:player-bitcoin": "node --test --test-concurrency=1 test/player-mint-regtest.mjs"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "2.4.0",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.4.0",
    "@scure/bip39": "1.3.0",
    "@scure/btc-signer": "1.8.1",
    "trac-wallet": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "playwright": "1.63.0"
  }
}
