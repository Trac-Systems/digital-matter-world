{
  "name": "dmw-contract",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.22.1 <25" },
  "type": "module",
  "main": "index.js",
  "pear": { "name": "dmw-contract", "type": "terminal" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:pear": "node scripts/pear-test.mjs",
    "simulate": "node scripts/simulate.mjs",
    "measure": "node scripts/measure.mjs",
    "measure:devnet": "node scripts/measure-devnet.mjs",
    "devnet": "node scripts/devnet.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "b4a": "1.8.1",
    "compact-encoding": "2.18.0",
    "crypto": "npm:bare-node-crypto@1.0.0",
    "fs": "npm:bare-node-fs@1.0.2",
    "path": "npm:bare-node-path@1.0.1",
    "process": "npm:bare-node-process@1.0.1",
    "util": "npm:bare-node-util@1.0.0",
    "pear-runtime": "1.3.1",
    "hyperdht": "6.29.6",
    "trac-msb": "github:Trac-Systems/main_settlement_bus#a8226b4ddfd5fab4643aadd02dee9f09b5355509",
    "trac-peer": "github:Trac-Systems/trac-peer#6602492ba0d9ed75dc87da5126042148e21ce8aa",
    "trac-wallet": "1.0.1"
  },
  "overrides": { "hyperdht": "$hyperdht", "trac-msb": "$trac-msb" }
}
